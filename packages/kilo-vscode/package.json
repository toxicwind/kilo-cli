{
  "name": "kappa-code",
  "displayName": "Kilo Code: AI Coding Agent, Copilot, and Autocomplete",
  "description": "Open Source AI coding agent that generates code from natural language, automates tasks, and runs terminal commands. Features inline autocomplete, browser automation, automated refactoring, and custom modes for planning, coding, and debugging. Supports 500+ AI models including Claude (Anthropic), Gemini, Grok, GPT, Codex and GLM.",
  "version": "7.0.25",
  "icon": "assets/icons/logo-outline-black.png",
  "publisher": "kilocode",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kilo-Org/kappa.git",
    "directory": "packages/kappa-vscode"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kappa-code-sidebar",
          "title": "Kilo Code (NEW)",
          "icon": "assets/icons/kappa-light.png",
          "darkIcon": "assets/icons/kappa-dark.png"
        }
      ]
    },
    "views": {
      "kappa-code-sidebar": [
        {
          "type": "webview",
          "id": "kappa-code.new.sidebarView",
          "name": "Kilo Code (NEW)"
        }
      ]
    },
    "commands": [
      {
        "command": "kappa-code.new.plusButtonClicked",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "kappa-code.new.agentManagerOpen",
        "title": "Agent Manager",
        "icon": "$(circuit-board)"
      },
      {
        "command": "kappa-code.new.marketplaceButtonClicked",
        "title": "Marketplace",
        "icon": "$(extensions)"
      },
      {
        "command": "kappa-code.new.historyButtonClicked",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "kappa-code.new.profileButtonClicked",
        "title": "Profile",
        "icon": "$(account)"
      },
      {
        "command": "kappa-code.new.settingsButtonClicked",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kappa-code.new.openInTab",
        "title": "Kilo Code (NEW)",
        "icon": {
          "light": "assets/icons/kappa-light.svg",
          "dark": "assets/icons/kappa-dark.svg"
        }
      },
      {
        "command": "kappa-code.new.autocomplete.generateSuggestions",
        "title": "Generate Suggested Edits",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.agentManager.previousSession",
        "title": "Agent Manager: Previous Session",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.agentManager.nextSession",
        "title": "Agent Manager: Next Session",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.agentManager.previousTab",
        "title": "Agent Manager: Previous Tab",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.agentManager.nextTab",
        "title": "Agent Manager: Next Tab",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.agentManager.showTerminal",
        "title": "Agent Manager: Focus Terminal",
        "category": "Kilo Code",
        "icon": "$(terminal)"
      },
      {
        "command": "kappa-code.new.agentManager.focusPanel",
        "title": "Agent Manager: Focus Panel",
        "category": "Kilo Code",
        "icon": "$(circuit-board)"
      },
      {
        "command": "kappa-code.new.agentManager.newTab",
        "title": "Agent Manager: New Tab",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.agentManager.closeTab",
        "title": "Agent Manager: Close Tab",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.agentManager.newWorktree",
        "title": "Agent Manager: New Worktree",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.agentManager.closeWorktree",
        "title": "Agent Manager: Close Worktree",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Kilo Code (NEW)",
        "icon": {
          "light": "assets/icons/kappa-light.svg",
          "dark": "assets/icons/kappa-dark.svg"
        }
      },
      {
        "command": "kappa-code.new.explainCode",
        "title": "Explain Code",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.fixCode",
        "title": "Fix Code",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.improveCode",
        "title": "Improve Code",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.addToContext",
        "title": "Add to Context",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.terminalAddToContext",
        "title": "Add Terminal Content to Context",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.terminalFixCommand",
        "title": "Fix This Command",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.terminalExplainCommand",
        "title": "Explain This Command",
        "category": "Kilo Code"
      },
      {
        "command": "kappa-code.new.focusChatInput",
        "title": "Focus Chat Input",
        "category": "Kilo Code"
      }
    ],
    "submenus": [
      {
        "id": "kappa-code.new.editorContextMenu",
        "label": "Kilo Code"
      },
      {
        "id": "kappa-code.new.terminalContextMenu",
        "label": "Kilo Code"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kappa-code.new.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == kappa-code.new.sidebarView"
        },
        {
          "command": "kappa-code.new.agentManagerOpen",
          "group": "navigation@1",
          "when": "view == kappa-code.new.sidebarView"
        },
        {
          "command": "kappa-code.new.marketplaceButtonClicked",
          "group": "navigation@2",
          "when": "view == kappa-code.new.sidebarView"
        },
        {
          "command": "kappa-code.new.historyButtonClicked",
          "group": "navigation@3",
          "when": "view == kappa-code.new.sidebarView"
        },
        {
          "command": "kappa-code.new.profileButtonClicked",
          "group": "navigation@4",
          "when": "view == kappa-code.new.sidebarView"
        },
        {
          "command": "kappa-code.new.settingsButtonClicked",
          "group": "navigation@5",
          "when": "view == kappa-code.new.sidebarView"
        }
      ],
      "scm/title": [
        {
          "command": "kappa-code.new.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "kappa-code.new.openInTab",
          "group": "navigation",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "submenu": "kappa-code.new.editorContextMenu",
          "group": "1_kilocode"
        }
      ],
      "kappa-code.new.editorContextMenu": [
        {
          "command": "kappa-code.new.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "kappa-code.new.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "kappa-code.new.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "kappa-code.new.addToContext",
          "group": "1_actions@4"
        }
      ],
      "terminal/context": [
        {
          "submenu": "kappa-code.new.terminalContextMenu",
          "group": "2_kilocode"
        }
      ],
      "kappa-code.new.terminalContextMenu": [
        {
          "command": "kappa-code.new.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "kappa-code.new.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "kappa-code.new.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kappa-code.new.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "kappa-code.new.agentManagerOpen",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "kappa-code.new.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "kappa-code.new.agentManager.previousSession",
        "key": "ctrl+up",
        "mac": "cmd+up",
        "when": "activeWebviewPanelId == 'kappa-code.new.AgentManagerPanel'"
      },
      {
        "command": "kappa-code.new.agentManager.nextSession",
        "key": "ctrl+down",
        "mac": "cmd+down",
        "when": "activeWebviewPanelId == 'kappa-code.new.AgentManagerPanel'"
      },
      {
        "command": "kappa-code.new.agentManager.previousTab",
        "key": "ctrl+left",
        "mac": "cmd+left",
        "when": "activeWebviewPanelId == 'kappa-code.new.AgentManagerPanel'"
      },
      {
        "command": "kappa-code.new.agentManager.nextTab",
        "key": "ctrl+right",
        "mac": "cmd+right",
        "when": "activeWebviewPanelId == 'kappa-code.new.AgentManagerPanel'"
      },
      {
        "command": "kappa-code.new.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'kappa-code.new.AgentManagerPanel'"
      },
      {
        "command": "kappa-code.new.agentManager.focusPanel",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "terminalFocus && kappa-code.agentTerminalFocus"
      },
      {
        "command": "kappa-code.new.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'kappa-code.new.AgentManagerPanel'"
      },
      {
        "command": "kappa-code.new.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'kappa-code.new.AgentManagerPanel'"
      },
      {
        "command": "kappa-code.new.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'kappa-code.new.AgentManagerPanel'"
      },
      {
        "command": "kappa-code.new.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'kappa-code.new.AgentManagerPanel'"
      }
    ],
    "configuration": {
      "title": "Kilo Code",
      "properties": {
        "kappa-code.new.language": {
          "type": "string",
          "default": "",
          "description": "Override the UI language for Kilo Code (e.g. en, de, ja). Empty means use VS Code's display language.",
          "enum": [
            "",
            "en",
            "zh",
            "zht",
            "ko",
            "de",
            "es",
            "fr",
            "da",
            "ja",
            "pl",
            "ru",
            "ar",
            "no",
            "br",
            "th",
            "bs"
          ],
          "enumDescriptions": [
            "Auto (VS Code language)",
            "English",
            "简体中文",
            "繁體中文",
            "한국어",
            "Deutsch",
            "Español",
            "Français",
            "Dansk",
            "日本語",
            "Polski",
            "Русский",
            "العربية",
            "Norsk",
            "Português (Brasil)",
            "ภาษาไทย",
            "Bosanski"
          ]
        },
        "kappa-code.new.model.providerID": {
          "type": "string",
          "default": "kappa",
          "description": "Default model provider ID for new sessions"
        },
        "kappa-code.new.model.modelID": {
          "type": "string",
          "default": "kappa/auto",
          "description": "Default model ID for new sessions"
        },
        "kappa-code.new.autocomplete.enableAutoTrigger": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic inline completion suggestions"
        },
        "kappa-code.new.autocomplete.enableSmartInlineTaskKeybinding": {
          "type": "boolean",
          "default": false,
          "description": "Enable smart inline task keybinding"
        },
        "kappa-code.new.autocomplete.enableChatAutocomplete": {
          "type": "boolean",
          "default": false,
          "description": "Enable chat textarea autocomplete"
        },
        "kappa-code.new.browserAutomation.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable browser automation powered by Playwright. When enabled, the AI agent can interact with web pages in a visible Chrome window."
        },
        "kappa-code.new.browserAutomation.useSystemChrome": {
          "type": "boolean",
          "default": true,
          "description": "Use your system's installed Chrome browser instead of downloading a separate Chromium instance."
        },
        "kappa-code.new.browserAutomation.headless": {
          "type": "boolean",
          "default": false,
          "description": "Run browser automation in headless mode (no visible window). When disabled, you can watch the agent interact with the browser."
        },
        "kappa-code.new.notifications.agent": {
          "type": "boolean",
          "default": true,
          "description": "Show notification when agent completes a task"
        },
        "kappa-code.new.notifications.permissions": {
          "type": "boolean",
          "default": true,
          "description": "Show notification on permission requests"
        },
        "kappa-code.new.notifications.errors": {
          "type": "boolean",
          "default": true,
          "description": "Show notification on errors"
        },
        "kappa-code.new.sounds.agent": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "none"
          ],
          "description": "Sound to play when agent completes"
        },
        "kappa-code.new.sounds.permissions": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "none"
          ],
          "description": "Sound to play on permission requests"
        },
        "kappa-code.new.sounds.errors": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "none"
          ],
          "description": "Sound to play on errors"
        }
      }
    }
  },
  "scripts": {
    "prepare:cli-binary": "bun script/local-bin.ts",
    "compile": "bun run prepare:cli-binary && bun run check-types && bun run lint && node esbuild.js",
    "watch": "bun run --parallel watch:esbuild watch:tsc",
    "watch:esbuild": "bun run prepare:cli-binary && node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:cli": "bun script/watch-cli.ts",
    "package": "bun run prepare:cli-binary && bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "bun test tests/unit/"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.108.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "qrcode": "^1.5.4",
    "ts-morph": "27.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@kappacode/kappa-i18n": "workspace:*",
    "@kappacode/kappa-ui": "workspace:*",
    "@kappacode/sdk": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@thisbeyond/solid-dnd": "0.7.5",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "eventsource": "^2.0.2",
    "fastest-levenshtein": "^1.0.16",
    "ignore": "^7.0.3",
    "js-tiktoken": "^1.0.18",
    "lru-cache": "^11.0.2",
    "openai": "^4.85.4",
    "quick-lru": "^7.0.0",
    "simple-git": "3.31.1",
    "solid-js": "^1.9.11",
    "uri-js": "^4.4.1",
    "web-tree-sitter": "^0.24.7",
    "zod": "^3.24.2"
  }
}
